import pygame
import sys

# Initialize Pygame
pygame.init()

# Setup Display
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Pygame Button Example")
clock = pygame.time.Clock()

# Colors (R, G, B)
COLOR_BG = (30, 30, 40)
COLOR_NORMAL = (70, 130, 180)
COLOR_HOVER = (100, 149, 237)
COLOR_TEXT = (255, 255, 255)

# Reusable Button Class
class Button:
    def __init__(self, x, y, width, height, text):
        self.rect = pygame.Rect(x, y, width, height)
        self.text = text
        self.font = pygame.font.SysFont("Arial", 24)
        self.is_hovered = False
        self.clicked = False

    def draw(self, surface):
        # 1. Update interaction state based on mouse position
        mouse_pos = pygame.mouse.get_pos()
        self.is_hovered = self.rect.collidepoint(mouse_pos)
        
        # 2. Pick color based on hover state
        current_color = COLOR_HOVER if self.is_hovered else COLOR_NORMAL
        
        # 3. Draw the button rectangle
        pygame.draw.rect(surface, current_color, self.rect, border_radius=8)
        
        # 4. Render and center the text inside the button
        text_surf = self.font.render(self.text, True, COLOR_TEXT)
        text_rect = text_surf.get_rect(center=self.rect.center)
        surface.blit(text_surf, text_rect)

    def check_click(self, event):
        # Trigger action only on a clean left-click inside the boundaries
        if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
            if self.is_hovered:
                return True
        return False


# Create an instance of the button
my_button = Button(x=325, y=260, width=150, height=50, text="Click Me")

# Main Game Loop
running = True
while running:
    # 1. Event Handling
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
            
        # Check if our button was clicked during this frame's events
        if my_button.check_click(event):
            print("Button Action Triggered!")

    # 2. Rendering
    screen.fill(COLOR_BG)       # Clear screen
    my_button.draw(screen)      # Draw button (handles hover color state automatically)
    
    pygame.display.flip()       # Update display
    clock.tick(60)              # Limit to 60 FPS

pygame.quit()
sys.exit()