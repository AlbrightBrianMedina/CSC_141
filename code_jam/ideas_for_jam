-Need multiple user inputs weather to draw or stay
-Chosen numbers need to be added with eachother
"""


import pygame 
pygame.init()
clock = pygame.time.Clock()
screen = pygame.display.set_mode(((640,480)))
my_image = pygame.image.load("code_jam/images/blue_puck.png")
image_rect = my_image.get_rect(center=(320,240))

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill((100, 255, 0))
     #image_rect.x += 1

     # Get pressed keys
    keys = pygame.key.get_pressed()
    dt = 0.3
    # W = Forward (up)
    if keys[pygame.K_w]:
        image_rect.y -= 20 * dt
    
    # S = Back (down)
    if keys[pygame.K_s]:
        image_rect.y += 20 * dt
    
    # A = Right (right)
    if keys[pygame.K_a]:
        image_rect.x -= 20 * dt
    
    # D = Left (left)
    if keys[pygame.K_d]:
        image_rect.x += 20 * dt


    if image_rect.x > screen.get_width():
        image_rect.x = -image_rect.width
    screen.blit(my_image, image_rect)
    pygame.display.flip()
    clock.tick(15)