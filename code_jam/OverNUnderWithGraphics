from random import randint
while True:
    computer_pick = randint(1, 13) 
    player_pick = randint(1, 13) 

    print (f"The player card landed on {computer_pick}, now choose: Over or Under?")
    user_input = input('Make your choice Player 1(Over or Under?):')

    if user_input.lower() == ("over") and (player_pick > computer_pick):
        print('you win')
    elif user_input.lower() == ("over") and (player_pick < computer_pick):
        print('you lose')
    elif user_input.lower() == ("over") and (player_pick == computer_pick):
        print("it's a tie")
    elif user_input.lower() == ("under") and (player_pick == computer_pick):
        print("It's a tie")
    elif user_input.lower() == ("under") and (player_pick > computer_pick):
        print("You lose")
    elif user_input.lower() == ("under") and (player_pick < computer_pick):
            print("You win")
    else:
        print("Please choose over or under")
    print(f"The answer was {player_pick}")

    repeat = input('Want to try again? (yes/no)')
    while repeat != 'no' and repeat != 'yes':
         repeat = input()
    if repeat == 'no':
            break     
