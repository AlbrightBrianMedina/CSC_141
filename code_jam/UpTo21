"""
Blackjack/ up to 21
-Need multiple randoms/randints from 1-10
-Need multiple user inputs weather to draw or stay
-Chosen numbers need to be added with eachother
"""

# OverUnder, card lands on a number, you have and 
# an opponent have to choose if the next number will be over or under the current roll
from random import randint
computer_pick = randint(1, 13) 
running = True
while running:
    print (f"The card landed on {computer_pick}, now choose: Over or Under?")

    user_input = input('Choose your number Player 1(1-13):')
    user_input = input('Choose your number Player 2(1-13):')

    if computer_pick > int(user_input):
        print("Player 1 Wins")
    elif computer_pick < int(user_input):
        print("Player 2 Win") 
    else:
        print("It's a tie")
